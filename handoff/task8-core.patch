+def write_report(directory: Path, name: str, **overrides) -> Path:
+    directory.mkdir(parents=True, exist_ok=True)
+    data = dict(GOOD_FIELDS, **overrides)
+    path = directory / name
+    path.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
+    return path
